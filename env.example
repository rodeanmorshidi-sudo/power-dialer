# --- Twilio credentials (Console > Account) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API key + secret: Console > Account > API keys & tokens > Create API key
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_key_secret_here

# TwiML App SID: Console > Voice > TwiML > TwiML Apps
# Set that app's Voice "Request URL" to  https://YOUR-BACKEND/voice  (HTTP POST)
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Twilio number (or verified caller ID) shown to the people you call. E.164 format.
TWILIO_CALLER_ID=+14155550100

PORT=3000
